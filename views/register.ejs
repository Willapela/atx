<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar · ATX TUNNEL ATX Config Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/clean-theme.css">
</head>
<body class="auth-body">
    <div class="glass-container auth-box">
        <div class="logo-area">
            <div class="auth-mark">CP</div>
            <div class="auth-eyebrow">ATX PANEL</div>
            <h2>Criar conta</h2>
            <p>Cadastre-se para gerenciar suas configurações remotas.</p>
        </div>
        <% if (error) { %>
            <div class="alert error"><%= error %></div>
        <% } %>
        <form action="/register" method="POST">
            <div class="form-group">
                <label>Usuário</label>
                <input type="text" name="username" placeholder="somente letras e números" required autocomplete="username" pattern="[A-Za-z0-9]+" title="Apenas letras e números, sem espaços">
            </div>
            <div class="form-group">
                <label>E-mail</label>
                <input type="email" name="email" placeholder="voce@email.com" required autocomplete="email">
            </div>
            <div class="form-group">
                <label>Senha</label>
                <input type="password" name="password" placeholder="mínimo 6 caracteres" required minlength="6" autocomplete="new-password">
            </div>
            <button type="submit" class="btn primary full-width">Criar conta</button>
        </form>
        <div class="auth-footer" style="text-align: center; margin-top: 1rem; font-size: 0.9rem; color: var(--text-muted);">
            Já tem uma conta? <a href="/login">Entrar</a>
        </div>
    </div>
</body>
</html>
