<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar · ATX TUNNEL ATX Config Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/clean-theme.css">
</head>
<body class="auth-body">
    <div class="glass-container auth-box">
        <div class="logo-area">
            <div class="auth-mark">CP</div>
            <div class="auth-eyebrow">ATX PANEL</div>
            <h2>Bem-vindo de volta</h2>
            <p>Entre para gerenciar suas configurações remotas.</p>
        </div>
        <% if (error) { %>
            <div class="alert error"><%= error %></div>
        <% } %>
        <% if (message) { %>
            <div class="alert" style="border-color: #a7f3d0; background:#ecfdf5; color:#059669;"><%= message %></div>
        <% } %>
        <form action="/login" method="POST">
            <div class="form-group">
                <label>Usuário ou e-mail</label>
                <input type="text" name="username" placeholder="admin ou voce@email.com" required autocomplete="username">
            </div>
            <div class="form-group">
                <label>Senha</label>
                <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password">
            </div>
            <div class="auth-forgot"><a href="/forgot-password">Esqueci minha senha</a></div>
            <button type="submit" class="btn primary full-width">Entrar no painel</button>
        </form>
        <div class="auth-footer" style="text-align: center; margin-top: 1rem; font-size: 0.9rem; color: var(--text-muted);">
            Não tem uma conta? <a href="/register">Registrar</a>
        </div>
    </div>
</body>
</html>
