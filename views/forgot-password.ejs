<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar senha · ATX TUNNEL ATX Config Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/clean-theme.css">
</head>
<body class="auth-body">
    <div class="glass-container auth-box">
        <div class="logo-area">
            <div class="auth-mark">CP</div>
            <div class="auth-eyebrow">ATX PANEL</div>
            <h2>Recuperar senha</h2>
            <p>Informe o e-mail cadastrado para receber um link de redefinição.</p>
        </div>
        <% if (error) { %>
            <div class="alert error"><%= error %></div>
        <% } %>
        <% if (message) { %>
            <div class="alert" style="border-color: #a7f3d0; background:#ecfdf5; color:#059669;"><%= message %></div>
        <% } %>
        <form action="/forgot-password" method="POST">
            <div class="form-group">
                <label>E-mail</label>
                <input type="email" name="email" value="<%= email || '' %>" placeholder="voce@email.com" required autocomplete="email">
            </div>
            <button type="submit" class="btn primary full-width">Enviar link de recuperação</button>
        </form>
        <div class="auth-footer" style="text-align:center; margin-top:1rem; font-size:.9rem; color:var(--text-muted);">
            <a href="/login">Voltar para o login</a>
        </div>
    </div>
</body>
</html>
